{
  "main_pass": [
    "-n",
    "-c:v", "h264_nvenc",
    "-preset", ["preset", ["p1", "p2", "p3", "p4", "p5", "p6", "p7"], {"default": "p4"}],
    "-tune", "hq",
    "-rc", "vbr",
    "-cq", ["cq", "INT", {"default": 17, "min": 0, "max": 51, "step": 1}],
    "-b:v", "0",
    "-pix_fmt", ["pix_fmt", ["yuv420p", "p010le"]]
  ],
  "audio_pass": ["-c:a", "aac", "-b:a", "192k", "-movflags", "use_metadata_tags"],
  "save_metadata": ["save_metadata", "BOOLEAN", {"default": true}],
  "trim_to_audio": ["trim_to_audio", "BOOLEAN", {"default": false}],
  "extension": "mp4"
}
